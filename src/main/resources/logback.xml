<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging for Cloud Logging (#751).

  Cloud Run collects stdout. When a line is a JSON object it is parsed into `jsonPayload`, and two field
  names are special — which is the whole reason this file is no longer a plain text pattern:

    severity     read as the log entry's severity, so `severity>=ERROR` filtering and severity-based
                 alerting work. A text pattern is opaque to the parser, so every line arrived as
                 DEFAULT and "show me today's errors" was unanswerable.
    stack_trace  picked up automatically by Cloud Error Reporting, which groups exceptions and shows
                 the trace. No agent, no SDK, no vendor — the field name IS the integration.

  MDC is emitted flat alongside them, which is how requestId/route/status/durationMs become queryable
  fields rather than text buried in a message.
-->
<configuration>
    <!-- Logback's WARN/TRACE are not Cloud Logging severities; see GcpSeverity.kt for why that matters. -->
    <conversionRule conversionWord="gcpSeverity" class="org.skopeo.common.logging.GcpSeverityConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>time</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>{"severity": "%gcpSeverity"}</pattern>
                </pattern>
                <message/>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <!-- Flat, so the keys below are top-level queryable fields.

                     ALLOWLISTED (#806): MDC is a publication channel, not a scratchpad — every appender
                     forwards it, and an error tracker would attach it to each event as searchable tags.
                     An unlisted key is dropped here rather than trusted, so a stray MDC.put elsewhere in
                     the codebase cannot publish a value on every line of the request. Keep in step with
                     LogFields.ALLOWED_MDC_KEYS; a test asserts the two agree. -->
                <mdc>
                    <includeMdcKeyName>requestId</includeMdcKeyName>
                    <includeMdcKeyName>logging.googleapis.com/trace</includeMdcKeyName>
                </mdc>
                <!-- The access line's fields (#805) arrive as a marker rather than via MDC, because MDC
                     values are always strings: `durationMs` and `status` have to stay JSON *numbers* for
                     a log-based distribution metric to read them (#809). -->
                <logstashMarkers/>
                <!-- Must stay `stack_trace`: it is what Cloud Error Reporting keys on. -->
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <!-- Application logger -->
    <logger name="org.skopeo" level="INFO" />

    <!-- Ktor loggers -->
    <logger name="io.ktor" level="INFO" />
    <logger name="io.ktor.server.plugins.calllogging" level="INFO" />

    <!-- Netty logger (reduce noise) -->
    <logger name="io.netty" level="WARN" />

    <!-- Console only: containers and cloud platforms collect stdout -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
