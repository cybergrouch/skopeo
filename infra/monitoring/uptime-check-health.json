{
  "displayName": "skopeo-api-health",
  "monitoredResource": {
    "type": "uptime_url",
    "labels": {
      "project_id": "PROJECT_ID_PLACEHOLDER",
      "host": "API_HOST_PLACEHOLDER"
    }
  },
  "httpCheck": {
    "requestMethod": "GET",
    "path": "/health",
    "port": 443,
    "useSsl": true,
    "validateSsl": true,
    "acceptedResponseStatusCodes": [
      { "statusClass": "STATUS_CLASS_2XX" }
    ]
  },
  "period": "60s",
  "timeout": "10s",
  "selectedRegions": ["ASIA_PACIFIC", "EUROPE", "USA_OREGON"],
  "checkerType": "STATIC_IP_CHECKERS"
}
