# Local overrides for apply.sh. Copy to `.env.local` — which is gitignored — and edit.
#
#     cp infra/monitoring/.env.local.example infra/monitoring/.env.local
#
# This exists so a value you want pinned on your machine does not have to live in a public repo. The
# script's built-in defaults are the real project settings and are safe to publish; anything you would
# rather not commit belongs here instead.
#
# Precedence: command-line flag > .env.local > exported environment > built-in default.
#
# Nothing here is required. The script works with no arguments and no .env.local.

# GCP_PROJECT_ID=skopeo-prod
# GCP_REGION=asia-southeast1
# CLOUD_RUN_SERVICE=skopeo

# Where alerts go. Must be a team-managed group, never a personal address (#190).
# ALERT_EMAIL=skopeo-alerts@googlegroups.com

# Host for the uptime check. Left unset, the script derives it from the deployed service, which is
# correct while there is no custom domain for the API. Set it once one is mapped: a check against
# *.run.app stays green through a DNS, TLS or domain-mapping failure — a full outage for every browser
# client that monitoring would never see.
# API_HOST=api.skopeo.co
